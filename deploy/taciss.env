# TACISS configuration. After editing:  sudo systemctl restart taciss

# Address/port the app listens on. 0.0.0.0 = reachable from the LAN.
# If ONLY reachable through a reverse proxy on this box, use 127.0.0.1.
TACISS_HOST=0.0.0.0
TACISS_PORT=8080

# Where the SQLite database lives.
TACISS_DATA=/var/lib/taciss

# 1 = signed-out visitors can view the dashboard, map, programs, agencies,
# incidents and SITREPs (read-only). Chat, activity logs and resources stay private.
TACISS_PUBLIC_READ=0

# Set to 1 when a reverse proxy / tunnel (Caddy, nginx, cloudflared) sits in front,
# so real client IPs and HTTPS are detected (secure cookies, HSTS).
TACISS_TRUST_PROXY=0

# Force the Secure cookie flag. Only use if EVERY client reaches TACISS over HTTPS;
# otherwise plain-HTTP LAN logins will stop working.
TACISS_SECURE_COOKIES=0

# How long a login lasts.
TACISS_SESSION_HOURS=72

# GitHub repo that `sudo taciss update` and the in-app update notice check.
TACISS_REPO=amorilab/taciss

# 1 = check GitHub once a day for a newer TACISS and tell admins in the app.
# Nothing is installed automatically. Set 0 on networks that must not reach the internet.
TACISS_UPDATE_CHECK=1

# 1 = keep a live, read-only APRS-IS connection for the APRS tab (needs internet).
# Set 0 on networks that must not reach the internet. Admins can also turn it off in Admin -> Settings.
TACISS_APRS=1

# Public address of this server, used for link previews when the link is shared on
# Facebook, Messenger, Discord, Slack and so on (e.g. https://taciss.com). Blank = work it out per request.
TACISS_PUBLIC_URL=
